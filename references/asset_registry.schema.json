    "solver": {"type": ["string", "null"]},
    "conditioning_contract": {"type": ["object", "string", "null"]},
    "dataset_manifest_path": {"type": ["string", "null"]},
    "dataset_license": {"type": ["string", "null"]},
    "status": {"type": "string"},
