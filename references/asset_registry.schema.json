    "checkpoint_path": {"type": ["string", "null"]},
    "checkpoint_sha256": {"type": ["string", "null"]},
    "checkpoint_size_bytes": {"type": ["integer", "null"]},
    "checkpoint_license": {"type": ["string", "null"]},
